---
import AppShell from '../../layouts/AppShell.astro';
import FavButton from '../../components/FavButton.astro';
import Icon from '../../components/Icon.astro';
import {
  masteries,
  masteryBySlug,
  masteryUrl,
  propertyBySlug,
  propertyLabel,
  propertyUrl,
  url,
  weaponGroup,
  weapons,
  weaponUrl,
} from '../../lib/data';

const diceAverage = (dice: string) => {
  const m = dice.match(/^(\d+)d(\d+)$/);
  return m ? (Number(m[1]) * (Number(m[2]) + 1)) / 2 : Number(dice);
};

const columns = [
  { key: 'name', label: 'Name' },
  { key: 'damage', label: 'Damage' },
  { key: null, label: 'Properties' },
  { key: 'mastery', label: 'Mastery' },
  { key: 'weight', label: 'Weight', num: true },
  { key: 'cost', label: 'Cost', num: true },
];
---

<AppShell title="Weapons" section="weapons" description="Sortable, filterable table of every D&D 2024 weapon with damage, properties, mastery, weight and cost.">
  <header class="page-head">
    <p class="eyebrow"><Icon name="swords" size={16} />Equipment</p>
    <h1>Weapons</h1>
    <p class="lede">All {weapons.length} weapons from the SRD. Tap a property or mastery for its full rule.</p>
  </header>

  <div class="toolbar" data-weapon-filters>
    <div class="toolbar-row">
      <label class="field">
        <span class="visually-hidden">Filter weapons</span>
        <Icon name="search" size={18} />
        <input class="input" type="search" placeholder="Filter by name, damage type or property…" autocomplete="off" data-filter-input />
      </label>
      <div class="segmented" role="group" aria-label="Weapon category">
        <button type="button" data-set="category" data-value="" aria-pressed="true">All</button>
        <button type="button" data-set="category" data-value="simple" aria-pressed="false">Simple</button>
        <button type="button" data-set="category" data-value="martial" aria-pressed="false">Martial</button>
      </div>
      <div class="segmented" role="group" aria-label="Melee or ranged">
        <button type="button" data-set="kind" data-value="" aria-pressed="true">All</button>
        <button type="button" data-set="kind" data-value="melee" aria-pressed="false">Melee</button>
        <button type="button" data-set="kind" data-value="ranged" aria-pressed="false">Ranged</button>
      </div>
    </div>
    <div class="chips-scroll" role="group" aria-label="Mastery">
      <button class="chip" type="button" data-set="mastery" data-value="" aria-pressed="true">Any mastery</button>
      {masteries.map((m) => <button class="chip" type="button" data-set="mastery" data-value={m.slug} aria-pressed="false">{m.name}</button>)}
    </div>
  </div>

  <div class="weapons-wrap">
    <div class="toolbar-row card-sort" style="margin-block-end: var(--space-s)">
      <label for="card-sort" class="result-count">Sort by</label>
      <select class="select" id="card-sort" data-card-sort>
        <option value="">SRD order</option>
        <option value="name:asc">Name (A–Z)</option>
        <option value="damage:desc">Damage (high–low)</option>
        <option value="damage:asc">Damage (low–high)</option>
        <option value="weight:asc">Weight (light–heavy)</option>
        <option value="cost:asc">Cost (low–high)</option>
        <option value="cost:desc">Cost (high–low)</option>
        <option value="mastery:asc">Mastery</option>
      </select>
      <span class="result-count" aria-live="polite" data-result-count>{weapons.length} weapons</span>
    </div>

    <table class="weapons-table">
      <caption class="visually-hidden">Weapons, sortable by column</caption>
      <thead>
        <tr>
          {
            columns.map((c) => (
              <th scope="col" class:list={{ num: c.num }}>
                {c.key ? (
                  <button class="sort-btn" type="button" data-sort={c.key}>
                    {c.label}
                    <Icon name="arrowUpDown" size={13} />
                  </button>
                ) : (
                  c.label
                )}
              </th>
            ))
          }
          <th scope="col"><span class="visually-hidden">Favourite</span></th>
        </tr>
      </thead>
      <tbody data-weapon-rows>
        {
          weapons.map((w, i) => {
            const mastery = masteryBySlug.get(w.mastery);
            return (
              <tr
                data-weapon
                data-order={i}
                data-category={w.category}
                data-kind={w.kind}
                data-mastery={w.mastery}
                data-name={w.name}
                data-damage={diceAverage(w.damage.dice)}
                data-weight={w.weightLb}
                data-cost={w.costCp}
                data-search={`${w.name} ${w.damage.type} ${w.propertiesText} ${mastery?.name ?? ''} ${weaponGroup(w)}`.toLowerCase()}
              >
                <td class="w-name">
                  <a href={weaponUrl(w.slug)}>{w.name}</a>
                  <small>{weaponGroup(w)}</small>
                </td>
                <td class="dmg">
                  {w.damage.dice} <span>{w.damage.type}</span>
                </td>
                <td class="w-props">
                  {w.properties.length ? (
                    <span class="prop-links">
                      {w.properties.map((p) => (
                        <a class="badge" href={propertyUrl(p.slug)} data-term={`properties/${p.slug}`} title={propertyBySlug.get(p.slug)?.summary}>
                          {propertyLabel(p)}
                        </a>
                      ))}
                    </span>
                  ) : (
                    <span class="muted" aria-label="No properties">—</span>
                  )}
                </td>
                <td class="w-mastery">
                  <a class="badge badge-gold" href={masteryUrl(w.mastery)} title={mastery?.summary}>{mastery?.name ?? w.mastery}</a>
                </td>
                <td class="num w-weight" data-label="Weight">{w.weight}</td>
                <td class="num w-cost" data-label="Cost">{w.cost}</td>
                <td class="w-fav"><FavButton id={`weapons/${w.slug}`} name={w.name} size={18} /></td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <div class="empty-state" hidden data-empty>
    <Icon name="swords" size={28} />
    <p><strong>No weapons match those filters.</strong></p>
    <button class="btn" type="button" data-reset>Clear filters</button>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>Rules for weapons</h2>
    </div>
    <div class="card-grid">
      <a class="card feature-card" href={url('masteries/')}>
        <span class="feature-icon"><Icon name="sparkles" /></span>
        <span><strong>Weapon Masteries</strong><br /><span class="card-summary">Cleave, Graze, Nick, Push, Sap, Slow, Topple, Vex</span></span>
        <Icon name="chevronRight" class="chev" />
      </a>
      <a class="card feature-card" href={url('properties/')}>
        <span class="feature-icon"><Icon name="tag" /></span>
        <span><strong>Weapon Properties</strong><br /><span class="card-summary">Finesse, Heavy, Light, Reach, Thrown, Versatile…</span></span>
        <Icon name="chevronRight" class="chev" />
      </a>
    </div>
  </section>
</AppShell>

<style>
  .w-fav { inline-size: 1%; padding-block: 0 !important; }
  @container weapons (width < 46rem) {
    .weapons-table .w-fav { position: absolute; inset-block-start: 0.25rem; inset-inline-end: 0.25rem; inline-size: auto; }
    .weapons-table tr { position: relative; padding-inline-end: 3.25rem; }
    .weapons-table .dmg { grid-column: 1 !important; grid-row: auto !important; text-align: start !important; }
  }
  a.card { text-decoration: none; color: var(--text); }
  a.card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); }
</style>

<script>
  const filters = document.querySelector<HTMLElement>('[data-weapon-filters]')!;
  const input = filters.querySelector<HTMLInputElement>('[data-filter-input]')!;
  const tbody = document.querySelector<HTMLElement>('[data-weapon-rows]')!;
  const rows = [...tbody.querySelectorAll<HTMLTableRowElement>('[data-weapon]')];
  const count = document.querySelector<HTMLElement>('[data-result-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const cardSort = document.querySelector<HTMLSelectElement>('[data-card-sort]')!;
  const sortButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-sort]')];

  type SetKey = 'category' | 'kind' | 'mastery';
  const state: Record<SetKey, string> = { category: '', kind: '', mastery: '' };
  let sortKey = '';
  let sortDir: 'asc' | 'desc' = 'asc';

  const params = new URLSearchParams(location.search);
  for (const k of ['category', 'kind', 'mastery'] as SetKey[]) state[k] = params.get(k) ?? '';
  input.value = params.get('q') ?? '';

  function applyFilters() {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      const d = row.dataset;
      const match =
        (!state.category || d.category === state.category) &&
        (!state.kind || d.kind === state.kind) &&
        (!state.mastery || d.mastery === state.mastery) &&
        terms.every((t) => d.search!.includes(t));
      row.hidden = !match;
      if (match) shown++;
    }
    filters.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => {
      b.setAttribute('aria-pressed', String(state[b.dataset.set as SetKey] === b.dataset.value));
    });
    count.textContent = `${shown} weapon${shown === 1 ? '' : 's'}`;
    empty.hidden = shown > 0;

    const next = new URLSearchParams();
    for (const [k, v] of Object.entries(state)) if (v) next.set(k, v);
    if (input.value.trim()) next.set('q', input.value.trim());
    const qs = next.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function applySort() {
    const numeric = sortKey === 'damage' || sortKey === 'weight' || sortKey === 'cost';
    const sorted = [...rows].sort((a, b) => {
      if (!sortKey) return Number(a.dataset.order) - Number(b.dataset.order);
      const av = a.dataset[sortKey]!;
      const bv = b.dataset[sortKey]!;
      const cmp = numeric ? Number(av) - Number(bv) : av.localeCompare(bv);
      return (sortDir === 'asc' ? cmp : -cmp) || a.dataset.name!.localeCompare(b.dataset.name!);
    });
    tbody.append(...sorted);
    sortButtons.forEach((btn) => {
      const th = btn.closest('th')!;
      if (btn.dataset.sort === sortKey) th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
      else th.removeAttribute('aria-sort');
    });
    cardSort.value = sortKey ? `${sortKey}:${sortDir}` : '';
  }

  filters.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-set]');
    if (!btn) return;
    state[btn.dataset.set as SetKey] = btn.dataset.value ?? '';
    applyFilters();
  });
  input.addEventListener('input', applyFilters);

  sortButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort!;
      if (sortKey !== key) {
        sortKey = key;
        sortDir = key === 'damage' || key === 'cost' ? 'desc' : 'asc';
      } else if ((sortDir === 'asc') === !(key === 'damage' || key === 'cost')) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortKey = '';
      }
      applySort();
    }),
  );
  cardSort.addEventListener('change', () => {
    const [key, dir] = cardSort.value.split(':');
    sortKey = key ?? '';
    sortDir = dir === 'desc' ? 'desc' : 'asc';
    applySort();
  });

  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    state.category = state.kind = state.mastery = '';
    input.value = '';
    applyFilters();
  });

  applyFilters();
</script>
